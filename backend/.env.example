# PostgreSQL (local or remote)
DATABASE_URL=jdbc:postgresql://localhost:5432/skillmark
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# For remote PostgreSQL (e.g., AWS RDS, Supabase, Neon, etc.)
# DATABASE_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require
# DATABASE_USERNAME=<username>
# DATABASE_PASSWORD=<password>

APP_BASE_URL=http://localhost:3000
APP_CERTIFICATE_VERIFY_BASE_URL=http://localhost:3000/certificates/verify
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT (generate a strong Base64-encoded secret, e.g. `openssl rand -base64 64`)
JWT_SECRET=<base64-encoded-secret>
JWT_EXPIRATION=86400000

# Email (SendGrid)
APP_EMAIL_FROM=noreply@skillmark.app
SENDGRID_API_KEY=<sendgrid-api-key>

R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET_NAME=<r2-bucket-name>
R2_PUBLIC_BASE_URL=<r2-public-base-url>

CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# Rate limiting (all optional; defaults are reasonable)
# RATE_LIMIT_AUTH_MAX_REQUESTS=200
# RATE_LIMIT_INVITE_MAX_REQUESTS=10
# RATE_LIMIT_ATTEMPT_MAX_REQUESTS=5
# RATE_LIMIT_PUBLIC_CERT_MAX_REQUESTS=30
# RATE_LIMIT_WINDOW_SECONDS=60
# Only enable when behind a trusted reverse proxy that sets X-Forwarded-For.
# RATE_LIMIT_TRUST_X_FORWARDED_FOR=false
