{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "frontend: start",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"start"
			],
			"options": {
				"cwd": "${workspaceFolder}/frontend"
			},
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "frontend: install",
			"type": "shell",
			"command": "npm",
			"args": [
				"install"
			],
			"options": {
				"cwd": "${workspaceFolder}/frontend"
			},
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		}
	]
}